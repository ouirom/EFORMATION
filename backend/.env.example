# Server Configuration
NODE_ENV=development
PORT=3001
HOST=localhost

# Database — DB_CLIENT selects the backend: 'pg' (default) routes through Knex to
# PostgreSQL, the database the app actually runs on. 'mssql' is a fallback for the
# native Windows-Auth ODBC driver, for SQL Server instances that can't use SQL-login
# auth. DB_USER/DB_PASSWORD are required for 'pg'; ignored by the 'mssql' Windows-Auth path.
DB_CLIENT=pg
DB_HOST=localhost
DB_PORT=5432
DB_NAME=db_eformation
DB_USER=postgres
DB_PASSWORD=
DB_TRUST_SERVER_CERTIFICATE=true
DB_ENCRYPT=false
DB_SSL=false

# Tenant new SSO/LDAP-provisioned users fall back to only when their tenant truly
# cannot be resolved from the auth context itself.
DEFAULT_TENANT_ID=1

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_REFRESH_EXPIRES_IN=30d

# Redis (for caching and sessions)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Frontend URL
FRONTEND_URL=http://localhost:3000

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=104857600

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@eformation.com
SMTP_FROM_NAME=EFormation

# Twilio (WhatsApp & SMS)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Firebase Cloud Messaging
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-firebase-client-email
FIREBASE_PRIVATE_KEY="your-firebase-private-key"

# Web Push (VAPID)
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@eformation.com

# OpenAI (for AI features)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Azure AD / Microsoft 365 SSO
AZURE_AD_TENANT_ID=your-azure-tenant-id
AZURE_AD_CLIENT_ID=your-azure-client-id
AZURE_AD_CLIENT_SECRET=your-azure-client-secret

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# LDAP / Active Directory
LDAP_URL=ldap://your-ldap-server:389
LDAP_BIND_DN=cn=service-account,dc=example,dc=com
LDAP_BIND_PASSWORD=your-ldap-service-account-password
LDAP_SEARCH_BASE=ou=users,dc=example,dc=com
LDAP_SEARCH_FILTER=(|(sAMAccountName={{username}})(mail={{username}}))
LDAP_EMAIL_ATTRIBUTE=mail
LDAP_NAME_ATTRIBUTE=displayName

# LiveKit (embedded video for live sessions with no external meetingUrl set --
# sign up free at https://cloud.livekit.io, create a project, and copy its
# WebSocket URL + API key/secret here. Until set, the "Rejoindre" button on a
# live session with no meetingUrl shows a clear "not configured" message
# instead of crashing.)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# LiveKit Egress (session recording) delivers lifecycle events to
# POST /api/v1/webhooks/livekit. In the LiveKit Cloud dashboard (Settings ->
# Webhooks), point it at https://<your-domain>/api/v1/webhooks/livekit -- no
# separate secret to configure, it's verified with the LIVEKIT_API_KEY/SECRET
# above. Recording itself also needs a per-tenant S3-compatible bucket
# configured via Admin > Visioconférence (recording_storage_settings table);
# there is no env-level fallback for that, unlike the LiveKit project itself.

# Zoom Integration
ZOOM_CLIENT_ID=your-zoom-client-id
ZOOM_CLIENT_SECRET=your-zoom-client-secret
ZOOM_ACCOUNT_ID=your-zoom-account-id

# Stripe (Optional payments)
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# Security
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100
# To access the app from another device on the same network (phone, tablet,
# another PC), add this machine's LAN IP here too, e.g.
# http://192.168.1.50:3000,http://192.168.1.50:3001 -- find your IP with
# `ipconfig` (Windows) or `ip addr` (Linux/Mac). Also set frontend/vite.config.ts's
# server.host to true (or '0.0.0.0') so the Vite dev server itself accepts
# connections from other devices, not just localhost.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Logging
LOG_LEVEL=info

# Certificate Generation
CERTIFICATE_VERIFY_URL=https://eformation.com/verify

# Error monitoring (Sentry) -- leave empty to disable. Once set, unhandled server
# errors (5xx) and uncaught exceptions are reported automatically.
SENTRY_DSN=
