# Server
NODE_ENV=development
PORT=3001
HOST=localhost

# Database - set DB_CLIENT to "mssql" or "postgres" to select the engine
DB_CLIENT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=db_eformation
DB_USER=
DB_PASSWORD=
DB_SSL=false
# SQL Server only
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# JWT
JWT_SECRET=eformation-secret-key-change-in-production-2024
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=eformation-refresh-secret-key-change-in-production-2024
JWT_REFRESH_EXPIRES_IN=30d

# Frontend
FRONTEND_URL=http://localhost:5173

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=104857600

# Default Tenant (for development)
DEFAULT_TENANT_ID=1
